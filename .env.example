# Backend Configuration
PORT=5000
NODE_ENV=development
# Signs parent and tutor sessions. Use 32+ random characters, different from ADMIN_JWT_SECRET.
JWT_SECRET=your-secret-key-change-in-production

# No SMS provider is connected yet: sign-in codes are printed in the server log. Set to true in
# local development to also return the code in the API response (the forms then show it).
# Never enable this in production.
OTP_DEV_ECHO=false

# Frontend origins allowed to call the API (comma-separated). Empty allows any origin (development only).
CORS_ORIGINS=http://localhost:3000

# MongoDB. Locally: `docker compose up -d mongo` and the value below. Production: the MongoDB Atlas
# connection string (see deploy/aws/README.md).
MONGODB_URI=mongodb://127.0.0.1:27017/hometutor?directConnection=true

# Where tutor KYC uploads are stored: local (development) or s3 (production).
STORAGE_DRIVER=local
UPLOADS_DIR=./backend/data/uploads
# For STORAGE_DRIVER=s3. On EC2 the instance role provides credentials; no keys in this file.
# AWS_REGION=ap-south-1
# S3_BUCKET=your-tutorhub-kyc-documents
# S3_PREFIX=tutor-documents/

# Set to 1 when the API runs behind a proxy or load balancer (Caddy, nginx, ALB).
# TRUST_PROXY=1

# Copy this file to .env.local in the repository root (the API reads root .env.local, then
# backend/.env). Quickest admin setup: cd backend && npm run setup:admin -- you@example.com
# Or by hand: ADMIN_PASSWORD_HASH must be a bcrypt hash (not the password), generated with
#   printf '%s' 'your-password' | node backend/scripts/hash-admin-password.js
# and wrapped in single quotes. ADMIN_JWT_SECRET needs 32+ characters and must differ from JWT_SECRET.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
ADMIN_JWT_SECRET=replace-with-random-secret-of-32-plus-characters
ADMIN_TOKEN_TTL=8h

# Email - Zoho Mail
ZOHO_MAIL_HOST=smtp.zoho.in
ZOHO_MAIL_PORT=465
ZOHO_MAIL_USER=your-zoho-email@example.com
ZOHO_MAIL_PASSWORD=your-zoho-password
ZOHO_MAIL_FROM=noreply@hometution.com

# Google Maps & Places API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Calendar API
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public contact details on the website (put these in frontend/.env.local; empty values are hidden).
NEXT_PUBLIC_CONTACT_PHONE=+91 98765 43210
NEXT_PUBLIC_CONTACT_WHATSAPP=919876543210
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# App Settings
APP_NAME=Home & Online Tutor Hub
APP_VERSION=1.0.0

# Matching Configuration
DEFAULT_HOME_RADIUS=8
MAX_EXTENDED_RADIUS=12
OFFER_TIMEOUT_MINUTES=10
