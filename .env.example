# Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production

# Database - Catalyst
CATALYST_PROJECT_ID=your_catalyst_project_id
CATALYST_API_KEY=your_catalyst_api_key

# Email - Zoho Mail
ZOHO_MAIL_HOST=smtp.zoho.in
ZOHO_MAIL_PORT=465
ZOHO_MAIL_USER=your-zoho-email@example.com
ZOHO_MAIL_PASSWORD=your-zoho-password
ZOHO_MAIL_FROM=noreply@hometution.com

# Google Maps & Places API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Calendar API
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App Settings
APP_NAME=home tution
APP_VERSION=1.0.0

# Matching Configuration
DEFAULT_HOME_RADIUS=8
MAX_EXTENDED_RADIUS=12
OFFER_TIMEOUT_MINUTES=10
