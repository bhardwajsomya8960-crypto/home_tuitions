# Copy to deploy/aws/.env.production on the server and fill in. Never commit the real file.

# Public domain (DNS A record pointing at the EC2 Elastic IP) and the email for HTTPS notices.
DOMAIN=example.com
ACME_EMAIL=you@example.com

# Public contact details shown on the website (leave empty to hide). WhatsApp: country code +
# number, digits only. Changing these needs a rebuild (./deploy.sh).
CONTACT_PHONE=+91 98765 43210
CONTACT_WHATSAPP=919876543210
CONTACT_EMAIL=hello@example.com

# MongoDB Atlas connection string (Database > Connect > Drivers). Use a database user that can
# only read/write this database, and allow only the server's Elastic IP in Atlas Network Access.
MONGODB_URI=mongodb+srv://tutorhub-api:REPLACE_PASSWORD@cluster0.xxxxx.mongodb.net/hometutor?retryWrites=true&w=majority

# Private S3 bucket for tutor KYC documents. Credentials come from the EC2 instance role; do not
# put AWS keys here.
AWS_REGION=ap-south-1
S3_BUCKET=REPLACE-tutorhub-kyc-documents
S3_PREFIX=tutor-documents/

# Session signing secrets: 32+ random characters each, different from each other.
#   openssl rand -hex 32
JWT_SECRET=REPLACE
ADMIN_JWT_SECRET=REPLACE

# Staff sign-in. ADMIN_PASSWORD_HASH is a bcrypt hash, created with:
#   printf '%s' 'the-password' | docker compose --env-file .env.production -f docker-compose.prod.yml run --rm -T api node scripts/hash-admin-password.js
# Wrap it in single quotes here because it contains $ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='REPLACE'
ADMIN_TOKEN_TTL=8h

# Optional: geocoding and email.
GOOGLE_MAPS_API_KEY=
ZOHO_MAIL_HOST=smtp.zoho.in
ZOHO_MAIL_PORT=465
ZOHO_MAIL_USER=
ZOHO_MAIL_PASSWORD=
ZOHO_MAIL_FROM=
